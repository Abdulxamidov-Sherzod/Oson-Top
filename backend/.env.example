# Ma'lumotlar bazasi
DATABASE_URL=postgresql+asyncpg://oson:oson@localhost:5432/oson_top

# JWT — ishlab chiqarishda albatta o'zgartiring
JWT_SECRET=almashtiring-bu-faqat-test-uchun
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# Telegram bot — @BotFather dan oling
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=OsonTopBot
# Bo'sh qoldirsangiz long polling ishlaydi (domen kerak emas).
# Serverda: https://api.osontop.uz/api/v1/auth/telegram/webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Egasining raqamlari — bu raqam bilan kirgan hisob har safar admin bo'ladi.
# Vergul bilan ajratiladi. Bo'sh qoldirsangiz hech kimga avtomatik huquq berilmaydi.
ADMIN_PHONES=+998901112233

# Telegramsiz kirish — FAQAT ishlab chiqishda
ALLOW_DEV_LOGIN=true

# Push — Firebase xizmat hisobi JSON'i. Faqat serverda (Render → Environment),
# bu yerga qo'ymang: ichidagi qator ko'chirish belgilari .env ni buzadi.
FCM_SERVICE_ACCOUNT=

# Rasmlar
MEDIA_DIR=./media
MEDIA_URL=/media
MAX_PHOTO_MB=8

# Moderatsiya
AUTO_APPROVE=false
